<?xml version="1.0"?>
<ruleset name="REST Cache Invalidation">
  <description>PHPCS ruleset for REST Cache Invalidation plugin.</description>

  <!-- Files to check -->
  <file>.</file>

  <!-- Exclude third-party and generated files -->
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*/tests/bootstrap.php</exclude-pattern>

  <!-- PHP version -->
  <config name="testVersion" value="8.1-"/>

  <!-- WordPress Coding Standards -->
  <rule ref="WordPress">
    <!-- Allow short ternary and null coalescing (PHP 8.1+ project) -->
    <exclude name="Universal.Operators.DisallowShortTernary"/>
  </rule>

  <!-- PSR-4 autoloaded classes and PHPUnit test classes cannot use class-*.php naming -->
  <rule ref="WordPress.Files.FileName">
    <exclude-pattern>*/src/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>
  </rule>

  <!-- Allowed global prefixes for constants, hooks, and global variables -->
  <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
    <properties>
      <property name="prefixes" type="array">
        <element value="rcin"/>
        <element value="rest_cache_invalidation"/>
      </property>
    </properties>
  </rule>

  <!-- Minimum WP version for deprecation checks -->
  <rule ref="WordPress.WP.DeprecatedFunctions">
    <properties>
      <property name="minimum_supported_version" value="6.0"/>
    </properties>
  </rule>

  <!-- PHPCompatibilityWP -->
  <rule ref="PHPCompatibilityWP"/>

  <ini name="memory_limit" value="256M"/>
</ruleset>
