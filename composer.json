{
  "name": "rest-cache-invalidation",
  "description": "Cache public WordPress REST API GET responses with correct invalidation.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.9",
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^9.6",
    "yoast/phpunit-polyfills": "^2.0",
    "brain/monkey": "^2.6"
  },
  "autoload": {
    "psr-4": {
      "RestCacheInvalidation\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "RestCacheInvalidation\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": "phpcs",
    "lint-fix": "phpcbf",
    "test": "phpunit"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
